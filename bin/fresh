#!/bin/zsh
# ==============================================================================
# fresh (v2.1) - Modern All-in-One Package Updater & Disk Space Optimizer
# Autodetects: Homebrew, NPM, PNPM, Yarn, Bun, Deno, Pip, Pipx, uv, Conda,
#              Rustup, Cargo, Go, Composer, Mac App Store (mas), Docker, Podman
# Optional: macOS System Software Updates (--macos / -m)
# https://github.com/suhaibbinyounis/fresh
# ==============================================================================

set -e
setopt NULL_GLOB 2>/dev/null || true

# --- Catppuccin Mocha Palette & Styling ---
BOLD="\033[1m"
DIM="\033[2m"
NC="\033[0m"

# Colors
C_TEXT="\033[38;2;205;214;244m"
C_BLUE="\033[38;2;137;180;250m"
C_CYAN="\033[38;2;137;220;235m"
C_GREEN="\033[38;2;166;227;161m"
C_YELLOW="\033[38;2;249;226;175m"
C_PEACH="\033[38;2;250;179;135m"
C_RED="\033[38;2;243;139;168m"
C_MAUVE="\033[38;2;203;166;247m"

LOG_FILE="/tmp/fresh.log"
rm -f "$LOG_FILE"

# --- Flags & Config ---
VERBOSE=false
UPDATE_MACOS=false
EMPTY_TRASH=false
NOTIFY=true

SKIP_BREW=false
SKIP_NODE=false
SKIP_PYTHON=false
SKIP_RUST=false
SKIP_GO=false
SKIP_CACHE=false

# Parse Command-Line Arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -v|--verbose)
      VERBOSE=true
      shift
      ;;
    -m|--macos)
      UPDATE_MACOS=true
      shift
      ;;
    -t|--trash)
      EMPTY_TRASH=true
      shift
      ;;
    --skip-brew)
      SKIP_BREW=true
      shift
      ;;
    --skip-node)
      SKIP_NODE=true
      shift
      ;;
    --skip-python)
      SKIP_PYTHON=true
      shift
      ;;
    --skip-rust)
      SKIP_RUST=true
      shift
      ;;
    --skip-go)
      SKIP_GO=true
      shift
      ;;
    --skip-cache)
      SKIP_CACHE=true
      shift
      ;;
    --no-notify)
      NOTIFY=false
      shift
      ;;
    -h|--help)
      echo -e "${BOLD}${C_CYAN}fresh${NC} ${DIM}v2.1${NC} — Modern All-in-One macOS Package & Space Optimizer"
      echo -e "\n${BOLD}USAGE:${NC}"
      echo -e "  fresh [OPTIONS]"
      echo -e "\n${BOLD}OPTIONS:${NC}"
      echo -e "  ${C_CYAN}-v, --verbose${NC}      Show live command outputs instead of spinners"
      echo -e "  ${C_CYAN}-m, --macos${NC}        Check & install recommended macOS software updates"
      echo -e "  ${C_CYAN}-t, --trash${NC}        Empty macOS user Trash during cleanup"
      echo -e "  ${C_CYAN}--skip-brew${NC}        Skip Homebrew maintenance"
      echo -e "  ${C_CYAN}--skip-node${NC}        Skip Node package managers (npm, pnpm, yarn, bun, deno)"
      echo -e "  ${C_CYAN}--skip-python${NC}      Skip Python toolchains (pip, pipx, uv, conda)"
      echo -e "  ${C_CYAN}--skip-rust${NC}        Skip Rust toolchains (rustup, cargo)"
      echo -e "  ${C_CYAN}--skip-go${NC}          Skip Go build & module caches"
      echo -e "  ${C_CYAN}--skip-cache${NC}       Skip developer and temporary cache clearing"
      echo -e "  ${C_CYAN}--no-notify${NC}        Disable macOS desktop notification"
      echo -e "  ${C_CYAN}-h, --help${NC}         Show this help message"
      exit 0
      ;;
    *)
      echo -e "${C_RED}Unknown option: $1${NC} (run ${C_CYAN}fresh --help${NC} for options)"
      exit 1
      ;;
  esac
done

# Cleanup on exit or Ctrl+C
cleanup_on_interrupt() {
  printf "\e[?25h" # Restore cursor
  echo -e "\n\n${C_RED}✖ Interrupted by user.${NC}"
  exit 130
}
trap cleanup_on_interrupt SIGINT SIGTERM

# --- Helper Functions ---
get_free_bytes() {
  df -b / | awk 'NR==2 {print $4 * 512}'
}

format_bytes() {
  local bytes=$1
  if (( bytes >= 1073741824 )); then
    printf "%.2f GB" $(( bytes / 1073741824.0 ))
  elif (( bytes >= 1048576 )); then
    printf "%.1f MB" $(( bytes / 1048576.0 ))
  elif (( bytes >= 1024 )); then
    printf "%.0f KB" $(( bytes / 1024.0 ))
  else
    printf "%d B" "$bytes"
  fi
}

run_task() {
  local icon="$1"
  local label="$2"
  shift 2

  if [ "$VERBOSE" = true ]; then
    echo -e "\n${BOLD}${C_BLUE}${icon} ${label}...${NC}"
    "$@"
    echo -e "${C_GREEN}✔${NC} ${label} ${DIM}done${NC}"
    return 0
  fi

  # Run in background and pipe to log file
  "$@" >> "$LOG_FILE" 2>&1 &
  local pid=$!

  # Spinner loop
  local frames=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
  local i=1
  printf "\e[?25l" # Hide cursor

  while kill -0 $pid 2>/dev/null; do
    printf "\r${C_BLUE}%s${NC} ${icon} %s\033[K" "${frames[$i]}" "$label"
    i=$(( (i % 10) + 1 ))
    sleep 0.08
  done

  # Check exit code
  wait $pid
  local exit_code=$?

  printf "\e[?25h" # Show cursor

  if [ $exit_code -eq 0 ]; then
    printf "\r${C_GREEN}✔${NC} ${icon} %s\033[K\n" "$label"
  else
    printf "\r${C_RED}✖${NC} ${icon} %s ${DIM}(failed - see %s)${NC}\033[K\n" "$label" "$LOG_FILE"
  fi
}

# --- Banner ---
echo -e "${BOLD}${C_CYAN}"
cat << 'EOF'
    ____               __  
   / __/______  _____/ /_ 
  / /_/ ___/ _ \/ ___/ __ \
 / __/ /  /  __(__  ) / / /
/_/ /_/   \___/____/_/ /_/ 
EOF
echo -e "${NC}${BOLD}All-in-One macOS Package & Space Optimizer${NC} ${DIM}v2.1${NC}\n"

START_BYTES=$(get_free_bytes)
START_TIME=$(date +%s)

typeset -a SUMMARY_ROWS

# ==============================================================================
# 1. macOS SYSTEM & MAC APP STORE
# ==============================================================================
if [ "$UPDATE_MACOS" = true ]; then
  run_task "🍏" "macOS: Installing recommended system software updates" softwareupdate --install --all --recommended
  SUMMARY_ROWS+=( "🍏 macOS System:Updates Applied" )
fi

if command -v mas >/dev/null 2>&1; then
  run_task "🍎" "App Store: Upgrading Mac App Store apps (mas)" mas upgrade
  SUMMARY_ROWS+=( "🍎 Mac App Store:Apps Upgraded" )
fi

# ==============================================================================
# 2. HOMEBREW
# ==============================================================================
if [ "$SKIP_BREW" = false ] && command -v brew >/dev/null 2>&1; then
  run_task "🍺" "Homebrew: Updating formulae & casks" brew update
  run_task "📦" "Homebrew: Upgrading packages" brew upgrade
  run_task "🧹" "Homebrew: Removing orphaned dependencies" brew autoremove
  run_task "💾" "Homebrew: Purging old bottles & caches" zsh -c 'brew cleanup --prune=all -s && rm -rf "$(brew --cache)"'
  SUMMARY_ROWS+=( "🍺 Homebrew:Updated & Cleaned" )
fi

# ==============================================================================
# 3. SECURITY & CA CERTIFICATES (Mozilla Bundle & OpenSSL Trust)
# ==============================================================================
if command -v brew >/dev/null 2>&1; then
  run_task "🔒" "Security: Syncing CA certificate bundle & OpenSSL trust" zsh -c '
    brew upgrade ca-certificates --quiet 2>/dev/null || true
    for ssl_bin in /opt/homebrew/opt/openssl@4/bin/openssl /opt/homebrew/opt/openssl@3/bin/openssl; do
      if [ -x "$ssl_bin" ]; then
        "$ssl_bin" rehash /opt/homebrew/etc/openssl@4/certs 2>/dev/null || true
        "$ssl_bin" rehash /opt/homebrew/etc/openssl@3/certs 2>/dev/null || true
      fi
    done
    if command -v pip3 >/dev/null 2>&1; then
      pip3 install --upgrade certifi --quiet 2>/dev/null || true
    fi
  '
  SUMMARY_ROWS+=( "🔒 CA Trust:Bundle & Certs Synced" )
fi

# ==============================================================================
# 3. NODE.JS & JAVASCRIPT ECOSYSTEM (Autodetected)
# ==============================================================================
if [ "$SKIP_NODE" = false ]; then
  # NPM
  if command -v npm >/dev/null 2>&1; then
    run_task "⚡" "NPM: Updating package manager & global packages" zsh -c 'npm install -g npm@latest --quiet 2>/dev/null || true && npm update -g --quiet 2>/dev/null || true'
    run_task "🗄️" "NPM: Cleaning & verifying global cache" zsh -c 'npm cache clean --force 2>/dev/null || npm cache verify'
    SUMMARY_ROWS+=( "⚡ NPM Global:Updated & Cache Purged" )
  fi

  # PNPM
  if command -v pnpm >/dev/null 2>&1; then
    run_task "📦" "PNPM: Updating global packages & pruning store" zsh -c 'pnpm update -g --quiet 2>/dev/null || true && pnpm store prune'
    SUMMARY_ROWS+=( "📦 PNPM:Updated & Store Pruned" )
  fi

  # Yarn
  if command -v yarn >/dev/null 2>&1; then
    run_task "🧶" "Yarn: Updating global packages & cleaning cache" zsh -c 'yarn global upgrade --quiet 2>/dev/null || true && yarn cache clean'
    SUMMARY_ROWS+=( "🧶 Yarn:Updated & Cache Cleaned" )
  fi

  # Bun
  if command -v bun >/dev/null 2>&1; then
    run_task "🥟" "Bun: Upgrading runtime & clearing module cache" zsh -c 'bun upgrade 2>/dev/null || true && bun pm cache rm 2>/dev/null || true'
    SUMMARY_ROWS+=( "🥟 Bun:Runtime & Cache Updated" )
  fi

  # Deno
  if command -v deno >/dev/null 2>&1; then
    run_task "🦕" "Deno: Upgrading runtime" zsh -c 'deno upgrade 2>/dev/null || true'
    SUMMARY_ROWS+=( "🦕 Deno:Runtime Upgraded" )
  fi
fi

# ==============================================================================
# 4. PYTHON ECOSYSTEM (Autodetected)
# ==============================================================================
if [ "$SKIP_PYTHON" = false ]; then
  # Pip
  if command -v pip3 >/dev/null 2>&1; then
    run_task "🐍" "Python: Upgrading pip & outdated packages" zsh -c '
      pip3 install --upgrade pip --quiet 2>/dev/null || true
      outdated=$(pip3 list --outdated --format=freeze 2>/dev/null | cut -d= -f1 || true)
      if [ -n "$outdated" ]; then
        echo "$outdated" | xargs -n1 pip3 install --upgrade --quiet 2>/dev/null || true
      fi
    '
    run_task "🗑️" "Python: Purging pip wheel cache" pip3 cache purge
    SUMMARY_ROWS+=( "🐍 Python / Pip:Up to Date & Cache Purged" )
  fi

  # Pipx
  if command -v pipx >/dev/null 2>&1; then
    run_task "📦" "Pipx: Upgrading isolated CLI applications" pipx upgrade-all
    SUMMARY_ROWS+=( "📦 Pipx:Applications Upgraded" )
  fi

  # uv
  if command -v uv >/dev/null 2>&1; then
    run_task "⚡" "uv: Cleaning package cache" uv cache clean
    SUMMARY_ROWS+=( "⚡ uv:Cache Cleared" )
  fi

  # Conda / Mamba
  if command -v conda >/dev/null 2>&1; then
    run_task "🐍" "Conda: Cleaning tarballs and unused packages" conda clean --all -y
    SUMMARY_ROWS+=( "🐍 Conda:Unused Packages Purged" )
  fi
fi

# ==============================================================================
# 5. RUST ECOSYSTEM (Autodetected)
# ==============================================================================
if [ "$SKIP_RUST" = false ]; then
  if command -v rustup >/dev/null 2>&1; then
    run_task "🦀" "Rust: Updating toolchains via rustup" rustup update
    SUMMARY_ROWS+=( "🦀 Rust / Rustup:Toolchains Updated" )
  fi

  if command -v cargo >/dev/null 2>&1; then
    run_task "📦" "Cargo: Cleaning registry and git caches" zsh -c '
      rm -rf ~/.cargo/registry/cache/* 2>/dev/null || true
      rm -rf ~/.cargo/git/checkouts/* 2>/dev/null || true
    '
    SUMMARY_ROWS+=( "📦 Cargo:Registry Cache Cleared" )
  fi
fi

# ==============================================================================
# 7. GO ECOSYSTEM (Autodetected)
# ==============================================================================
if [ "$SKIP_GO" = false ] && command -v go >/dev/null 2>&1; then
  run_task "🐹" "Go: Cleaning module, build & test caches" go clean -cache -modcache -testcache
  SUMMARY_ROWS+=( "🐹 Go:Module & Build Cache Cleared" )
fi

# ==============================================================================
# 8. JAVA & JVM ECOSYSTEM (Autodetected)
# ==============================================================================
if [ -d "$HOME/.sdkman" ]; then
  run_task "☕" "Java: Upgrading SDKMAN candidates" zsh -c '
    export SDKMAN_DIR="$HOME/.sdkman"
    [[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
    sdk selfupdate force 2>/dev/null || true
    sdk upgrade 2>/dev/null || true
  '
  SUMMARY_ROWS+=( "☕ Java / SDKMAN:SDKs Upgraded" )
fi

if [ -d "$HOME/.gradle/caches" ]; then
  run_task "🐘" "Gradle: Purging stale wrapper & build caches" zsh -c '
    rm -rf ~/.gradle/caches/transforms-* 2>/dev/null || true
    rm -rf ~/.gradle/caches/journal-* 2>/dev/null || true
  '
fi

# ==============================================================================
# 7. PHP & COMPOSER (Autodetected)
# ==============================================================================
if command -v composer >/dev/null 2>&1; then
  run_task "🐘" "Composer: Updating global packages & cleaning cache" zsh -c '
    composer global update --quiet 2>/dev/null || true
    composer clear-cache --quiet 2>/dev/null || true
  '
  SUMMARY_ROWS+=( "🐘 Composer:Updated & Cache Cleared" )
fi

# ==============================================================================
# 8. CONTAINERS (Docker / Podman - Autodetected if running)
# ==============================================================================
if command -v docker >/dev/null 2>&1; then
  if docker info >/dev/null 2>&1; then
    run_task "🐳" "Docker: Pruning dangling build caches & images" docker system prune -f
    SUMMARY_ROWS+=( "🐳 Docker:Dangling Images Pruned" )
  fi
fi

if command -v podman >/dev/null 2>&1; then
  run_task "🦭" "Podman: Pruning unused containers & images" podman system prune -f
  SUMMARY_ROWS+=( "🦭 Podman:Containers Pruned" )
fi

# ==============================================================================
# 9. DEVELOPER & SYSTEM CACHES
# ==============================================================================
if [ "$SKIP_CACHE" = false ]; then
  run_task "🧹" "System: Clearing developer & app caches" zsh -c '
    rm -rf ~/.cache/* 2>/dev/null || true
    rm -rf ~/Library/Developer/Xcode/DerivedData/* 2>/dev/null || true
    rm -rf ~/.wrangler/tmp 2>/dev/null || true
    [ -d "$HOME/projects" ] && find "$HOME/projects" -name ".DS_Store" -depth -delete 2>/dev/null || true
  '
  CACHE_STATUS="Xcode, Wrangler & Temp Cleared"

  if [ "$EMPTY_TRASH" = true ]; then
    run_task "🗑️" "System: Emptying macOS user Trash" rm -rf ~/.Trash/*
    CACHE_STATUS="Caches Cleared + Trash Emptied"
  fi
  SUMMARY_ROWS+=( "🧹 System Caches:$CACHE_STATUS" )
fi

# ==============================================================================
# 10. SUMMARY & REPORTING
# ==============================================================================
END_BYTES=$(get_free_bytes)
END_TIME=$(date +%s)
DURATION=$(( END_TIME - START_TIME ))

DIFF_BYTES=$(( END_BYTES - START_BYTES ))
if (( DIFF_BYTES > 0 )); then
  SPACE_FORMATTED=$(format_bytes $DIFF_BYTES)
  SPACE_DISPLAY="${BOLD}${C_GREEN}${SPACE_FORMATTED}${NC}"
else
  SPACE_FORMATTED="0 B"
  SPACE_DISPLAY="${DIM}System was already clean${NC}"
fi

DURATION_FORMATTED="${DURATION}s"

# Render Gorgeous Summary Card
echo -e "\n${C_MAUVE}╭────────────────────────────────────────────────────────╮${NC}"
echo -e "${C_MAUVE}│${NC}  ${BOLD}${C_GREEN}✨  Maintenance Complete!${NC}                            ${C_MAUVE}│${NC}"
echo -e "${C_MAUVE}├────────────────────────────────────────────────────────┤${NC}"
printf "${C_MAUVE}│${NC}  %-18s ${BOLD}%-33s${NC} ${C_MAUVE}│${NC}\n" "⏱  Time Elapsed:" "$DURATION_FORMATTED"
printf "${C_MAUVE}│${NC}  %-18s %-42b ${C_MAUVE}│${NC}\n" "💾 Space Recovered:" "$SPACE_DISPLAY"

for row in "${SUMMARY_ROWS[@]}"; do
  key="${row%%:*}"
  val="${row#*:}"
  printf "${C_MAUVE}│${NC}  %-18s %-33s ${C_MAUVE}│${NC}\n" "$key" "$val"
done

echo -e "${C_MAUVE}╰────────────────────────────────────────────────────────╯${NC}\n"

# Optional Desktop Notification
if [ "$NOTIFY" = true ] && [ "$DURATION" -ge 4 ]; then
  osascript -e "display notification \"Recovered $SPACE_FORMATTED in ${DURATION}s\" with title \"fresh\" subtitle \"Maintenance Complete ✨\"" 2>/dev/null || true
fi
